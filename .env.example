# Copy this file to .env and fill in the values for MySQL setup.
# For SQLite (local development), no configuration is needed.

# Set to True to use MySQL instead of SQLite
USE_MYSQL=False

# MySQL connection settings (only needed if USE_MYSQL=True)
DB_NAME=medsite
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Django secret key (change in production)
SECRET_KEY=django-insecure-change-me-in-production

# Debug mode (set to False in production)
DEBUG=True

# Allowed hosts (space-separated, e.g. "localhost 127.0.0.1 yourdomain.com")
ALLOWED_HOSTS=localhost 127.0.0.1
